# ---------------------------------------------------------------------------
# bible-dyb-repo — configuration
# Copy this file to `.env` (or `.env.local`) and fill in what you need.
# ---------------------------------------------------------------------------

# Where the reader gets scripture text from:
#   "demo"      -> reads the bundled KJV dataset (works with zero config)
#   "supabase"  -> reads from your live Supabase project
DATA_MODE=demo

# ---------------------------------------------------------------------------
# Supabase connection (only needed when DATA_MODE=supabase)
#
# Project ref you supplied: odjrheaglkptzqiamztn
#   NEXT_PUBLIC_SUPABASE_URL = https://odjrheaglkptzqiamztn.supabase.co
# The anon/public key is shown in: Supabase Dashboard -> Settings -> API Keys
#   ("Project URL" and the publishable "anon" key)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: rename these if your existing Bible tables have different names.
# Column layout is expected to match the schema in db/migration.sql.
# Defaults below match the canonical schema this project creates.
SUPABASE_BOOKS_TABLE=books
SUPABASE_VERSES_TABLE=verses
